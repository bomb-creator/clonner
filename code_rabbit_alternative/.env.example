# ---------------------------------------------------------------------------
# Code Review Agent — environment configuration
#
# Copy to .env and fill in what you need. EVERY key here is optional:
# with none of them set, the app runs on the offline static engine.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Which provider to use by default. Leave unset to auto-select the first
# provider that has a key, falling back to `demo` (offline).
# Valid: demo groq gemini openrouter cerebras together deepinfra mistral
#        sambanova xai ollama lmstudio
# REVIEW_PROVIDER=groq

# Override the model for the chosen provider (see /api/providers for ids).
# REVIEW_MODEL=llama-3.3-70b-versatile

# quick | standard | deep
# REVIEW_EFFORT=standard

# Lower is more deterministic. Security and bug passes cap this at 0.15 anyway.
# REVIEW_TEMPERATURE=0.2

# --- Free API keys (any ONE of these is enough for full semantic review) ----

# Groq — free tier, no credit card, the fastest option here.
# Get a key: https://console.groq.com/keys
# GROQ_API_KEY=

# Google Gemini — generous free tier, 1M token context (great for whole repos).
# Get a key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GOOGLE_API_KEY=            # accepted as an alias

# OpenRouter — routes to many models; the `:free` ones cost nothing.
# Get a key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Cerebras — free inference tier, very high tokens/second.
# CEREBRAS_API_KEY=

# Together AI — free credits on signup.
# TOGETHER_API_KEY=

# DeepInfra / Mistral / SambaNova / xAI
# DEEPINFRA_API_KEY=
# MISTRAL_API_KEY=
# SAMBANOVA_API_KEY=
# XAI_API_KEY=

# --- Local runtimes (no key, no network, no cost) ---------------------------
# Set to 1 to auto-select Ollama when no cloud key is present.
# OLLAMA_AUTOSTART=0
# Pull a model first:  ollama pull qwen2.5-coder:7b

# --- GitHub (optional) ------------------------------------------------------
# Only needed for PRIVATE repos and for posting reviews back to a PR.
# Public repos can be fetched with no token at all (60 requests/hour).
# With a token: 5000 requests/hour.
# GITHUB_TOKEN=

# --- Server -----------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# Comma-separated list; only needed if you host the frontend on another origin.
# CORS_ORIGINS=
